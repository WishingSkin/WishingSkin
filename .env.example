# Compose substitution only. Native Go commands read process environment variables.
# Replace the example passwords before use. Select one database deployment.
WS_PUBLIC_URL=http://localhost:8090
# Optional CIDRs of proxies that replace/append X-Forwarded-For correctly.
# Empty means ignore all forwarding headers. Never include untrusted clients.
WS_TRUSTED_PROXIES=
WS_DATABASE_DSN=postgres://wishingskin:replace-this-password@postgres:5432/wishingskin?sslmode=disable
POSTGRES_PASSWORD=replace-this-password

# Initial email and Turnstile configuration; saved admin settings take precedence.
# Fresh installs use email-verified registration, which requires configured email and Turnstile.
# Existing registration settings are preserved; BS imports close registration.
# Both Turnstile values are required together. Never put the secret in the frontend.
WS_TURNSTILE_SITE_KEY=
WS_TURNSTILE_SECRET=
WS_SMTP_ADDRESS=
WS_SMTP_FROM=
WS_SMTP_USERNAME=
WS_SMTP_PASSWORD=
# starttls (default), tls (implicit TLS), or local (loopback-only test mail).
WS_SMTP_TLS=starttls

# MySQL alternative (also replace WS_DATABASE_DSN above):
# WS_DATABASE_DSN=wishingskin:replace-this-password@tcp(mysql:3306)/wishingskin?parseTime=true
# MYSQL_PASSWORD=replace-this-password
# MYSQL_ROOT_PASSWORD=replace-with-a-separate-root-password
